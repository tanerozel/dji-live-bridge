    <string name="guide_flow_title">From your drone to a live stream</string>
    <string name="guide_flow_body">DJI Fly on the remote controller sends the picture to this phone, and the phone passes it on to the platforms you pick.</string>
    <string name="guide_connect_title">First, connect the drone</string>
    <string name="guide_connect_body">Type the address on the screen into DJI Fly\'s RTMP field. The drone\'s picture shows on the phone right away; you are not live anywhere yet.</string>
    <string name="guide_live_title">Then go live</string>
    <string name="guide_live_body">Pick one or more platforms, paste the stream key and press Go live. The server addresses are ready.</string>

