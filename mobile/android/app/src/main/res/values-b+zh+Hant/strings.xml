    <!-- Platforms. on_* are phrases for where the stream is, written for the middle of a sentence; the app capitalizes a sentence that starts with one. -->
    <string name="platform_custom">自訂 RTMP</string>
    <string name="on_instagram">在 Instagram 上</string>
    <string name="on_tiktok">在 TikTok 上</string>
    <string name="on_youtube">在 YouTube 上</string>
    <string name="on_facebook">在 Facebook 上</string>
    <string name="on_twitch">在 Twitch 上</string>
    <string name="on_kick">在 Kick 上</string>
    <string name="on_custom">在自訂伺服器上</string>
    <string name="key_help_instagram">在 instagram.com：建立 (+) → 直播影片，然後複製「串流網址」和「串流金鑰」。Instagram 每次直播都會產生新的金鑰。</string>
    <string name="key_help_tiktok">在 TikTok LIVE Center 開啟串流金鑰畫面，複製伺服器位址與串流金鑰。TikTok 每次直播都會產生新的金鑰。注意：TikTok 只會將串流金鑰提供給其核准的帳號；能用手機開直播並不足夠。如果 LIVE Center 看不到金鑰，代表你的帳號尚未取得權限，本 App 無法改變這一點。</string>
    <string name="key_help_youtube">在 YouTube 工作室中：建立 → 開始直播 → 直播軟體，然後複製「串流金鑰」。除非你重設，否則金鑰不會改變。</string>
    <string name="key_help_facebook">在 facebook.com 上：直播視訊 → 直播軟體，然後複製「串流金鑰」。除非你啟用了固定金鑰，否則 Facebook 每場直播都會給新的金鑰。</string>
    <string name="key_help_twitch">在 Twitch 創作者儀表板中：設定 → 直播，然後複製你的主要串流金鑰。</string>
    <string name="key_help_kick">在 Kick 開啟 Creator Dashboard → Settings → Stream URL &amp; Key，然後複製金鑰。如果那裡顯示不同的 Stream URL，請用它取代伺服器位址。</string>
    <string name="key_help_custom">貼上你的伺服器提供的 RTMP 或 RTMPS 位址與串流金鑰。</string>
    <string name="server_placeholder">rtmp://your.server/live</string>
    <string name="live_reminder_instagram">現在請在 Instagram 按下「開始直播」；之後直播才會公開。</string>
    <string name="live_reminder_tiktok">請查看 TikTok LIVE Center；可能還需要在那裡開始直播。</string>
    <string name="live_reminder_youtube">若未開啟自動開始，請在 YouTube 工作室中按「開始直播」。</string>
    <string name="live_reminder_facebook">Facebook 會先顯示預覽；在那裡按「開始直播」後觀眾才看得到。</string>

